# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올라가지 않습니다.

# 네이버 클라우드 플랫폼 > Maps > Mobile Dynamic Map 의 Client ID.
# 지도 SDK가 앱에서 직접 네이버 서버와 통신하므로 앱 번들에 포함될 수밖에 없습니다.
# 숨기는 대신 NCP 콘솔에 등록한 패키지명으로 사용처가 제한됩니다.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# 쉼터 데이터 매니페스트 URL (Cloud Functions가 갱신, GCS/Firebase Hosting에 호스팅).
# 비워두면 목 데이터로 동작합니다.
EXPO_PUBLIC_SHELTER_MANIFEST_URL=

# 주의: 공공데이터포털 서비스키는 여기에 넣지 마세요.
# EXPO_PUBLIC_ 값은 JS 번들에 평문으로 박혀 APK 디컴파일로 노출됩니다.
# 서비스키는 Cloud Functions 환경변수에만 둡니다.
