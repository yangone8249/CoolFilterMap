# ⚠️ 이 파일은 git에 올라간다. 여기에 실제 비밀번호를 적지 말 것.
#
# 이 파일을 keystore.properties로 복사한 뒤, 복사본에 값을 채운다.
# keystore.properties와 *.keystore는 gitignore 대상이다.
#
# 키를 잃어버리면 같은 앱으로 업데이트를 낼 수 없다. 반드시 백업할 것.
# 키 생성은 README의 '릴리스 빌드' 절 참고.

# 프로젝트 루트 기준 경로
storeFile=release.keystore
storePassword=
keyAlias=coolfiltermap
keyPassword=
