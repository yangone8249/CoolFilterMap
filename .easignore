# EAS는 빌드용 압축본을 만들 때 이 파일이 있으면 .gitignore 대신 이걸 본다.
# 내용은 .gitignore와 같되 .env만 뺐다. .env가 빠지면 EXPO_PUBLIC_ 값들이
# 비어서 지도 Client ID 없는 APK가 나온다.
#
# .gitignore를 고치면 여기도 같이 맞출 것.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*

# 서명 키는 절대 올리지 않는다
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# typescript
*.tsbuildinfo

# prebuild가 다시 만든다
/ios
/android
